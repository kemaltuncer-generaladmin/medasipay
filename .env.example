# MedAsi Pay
# Qlinik/Praticase/SourceBase kart, banka transferi checkout ve admin onay servisi.

APP_URL=https://odeme.medasi.com.tr
APP_ENV=production
DATA_DIR=/data

# Qlinik/Praticase backendlerinin checkout session oluşturmak için göndereceği anahtar.
MEDASIPAY_API_KEY=

# Admin panelin sipariş/dekont görmesi ve onay vermesi için göndereceği anahtar.
MEDASIPAY_ADMIN_KEY=

# Admin panel push bildirimi (Apple Push Notification service)
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_BUNDLE_ID=com.medasi.adminpanel
APNS_AUTH_KEY_PATH=/run/secrets/AuthKey.p8
# APNS_AUTH_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
APNS_ENVIRONMENT=production
# Critical Alerts Apple özel entitlement gerektirir; yoksa false bırakılmalı.
APNS_CRITICAL_ALERTS=false

# Onay sonrası Qlinik/Praticase entitlement webhook imzası için ortak secret.
MEDASIPAY_WEBHOOK_SECRET=

# Canlı checkout yalnız bu ürün-hedef eşleşmelerine imzalı hak bildirimi yollar.
QLINIK_PAYMENT_WEBHOOK_URL=https://qlinik.medasi.com.tr/functions/v1/qlinik
PRATICASE_PAYMENT_WEBHOOK_URL=https://qlinik.medasi.com.tr/functions/v1/praticase-storekit-verify
SOURCEBASE_PAYMENT_WEBHOOK_URL=https://medasi.com.tr/functions/v1/sourcebase

# Banka transferi
BANK_ACCOUNT_NAME="MedAsi Teknoloji A.Ş."
BANK_IBAN=

# Kuveyt Türk Sanal POS (3D Secure Model)
# KUVEYT_POS_ENV=test iken test URL'leri, production iken canlı URL'ler kullanılır.
KUVEYT_POS_ENV=production
KUVEYT_POS_CUSTOMER_ID=
KUVEYT_POS_MERCHANT_ID=
KUVEYT_POS_USER_NAME=
KUVEYT_POS_PASSWORD=
KUVEYT_POS_CURRENCY_CODE=0949
KUVEYT_POS_INSTALLMENT_COUNT=0
KUVEYT_POS_PAY_GATE_API_VERSION=TDV2.0.0
KUVEYT_POS_PROVISION_GATE_API_VERSION=1.0.0
# İsteğe bağlı URL override:
# KUVEYT_POS_PAY_GATE_URL=
# KUVEYT_POS_PROVISION_GATE_URL=

# Destek formu (Resend ile e-posta gönderimi)
# Domain Resend panelinde doğrulanmış olmalı; doğrulanana kadar SUPPORT_FROM_EMAIL
# için "MedAsi Destek <onboarding@resend.dev>" gibi geçici bir adres kullanılabilir.
RESEND_API_KEY=
SUPPORT_EMAIL=destek@medasi.com.tr
SUPPORT_FROM_EMAIL="MedAsi Destek <destek@medasi.com.tr>"
SUPPORT_CORS_ORIGINS=https://odeme.medasi.com.tr,https://indir.medasi.com.tr
