# MedAsi Pay
# Qlinik/Praticase banka transferi checkout ve admin onay servisi.

APP_URL=https://odeme.medasi.com.tr
APP_ENV=production
DATA_DIR=/data

# Qlinik/Praticase backendlerinin checkout session oluşturmak için göndereceği anahtar.
MEDASIPAY_API_KEY=

# Admin panelin sipariş/dekont görmesi ve onay vermesi için göndereceği anahtar.
MEDASIPAY_ADMIN_KEY=

# Onay sonrası Qlinik/Praticase entitlement webhook imzası için ortak secret.
MEDASIPAY_WEBHOOK_SECRET=

# Banka transferi
BANK_ACCOUNT_NAME="MedAsi Teknoloji A.Ş."
BANK_IBAN=
